#!/usr/bin/env python3
import os
import json
import glob
import sys

# Dynamically resolve root and results directory relative to script
script_dir = os.path.dirname(os.path.abspath(__file__))
root_dir = os.path.abspath(os.path.join(script_dir, ".."))
base_dir = os.path.join(root_dir, "results")

topologies = [
    "collocated_1x_tp2",
    "collocated_2x_tp1",
    "collocated_4x_tp1",
    "collocated_2x_tp2",
    "disagg_1p1d",
    "disagg_1p2d",
    "disagg_1p3d",
    "disagg_2p2d",
    "disagg_1p1d_ib",
]

expected_workloads = [
    # Static closed-loop concurrency sweeps
    "decode_heavy_256x1024_c1",
    "decode_heavy_256x1024_c4",
    "decode_heavy_256x1024_c16",
    "decode_heavy_256x1024_c32",
    "decode_heavy_256x1024_c64",
    "balanced_1024x512_c1",
    "balanced_1024x512_c4",
    "balanced_1024x512_c16",
    "balanced_1024x512_c32",
    "enterprise_rag_8192x128_c1",
    "enterprise_rag_8192x128_c4",
    "enterprise_rag_8192x128_c8",
    "enterprise_rag_8192x128_c16",
    # Context length sweeps
    "context_sweep_512in_32out",
    "context_sweep_1024in_32out",
    "context_sweep_2048in_32out",
    "context_sweep_4096in_32out",
    "context_sweep_8192in_32out",
    "context_sweep_16384in_32out",
    # Burst interference tests
    "injected_burst",
    "decode_under_burst",
    # Calibrated Poisson open-loop rate sweeps (10 workloads)
    "poisson_balanced_1024x512_rate2",
    "poisson_balanced_1024x512_rate4",
    "poisson_balanced_1024x512_rate8",
    "poisson_balanced_1024x512_rate12",
    "poisson_balanced_1024x512_rate16",
    "poisson_enterprise_rag_8192x128_rate1.1",
    "poisson_enterprise_rag_8192x128_rate2.2",
    "poisson_enterprise_rag_8192x128_rate3.1",
    "poisson_enterprise_rag_8192x128_rate3.8",
    "poisson_enterprise_rag_8192x128_rate4.3",
]

print("=" * 70)
print(f" 1. AUDITING ALL {len(topologies) * len(expected_workloads)} BENCHMARK JSON DATASETS")
print("=" * 70)
total_checked = 0
total_passed = 0
failed_details = []

for topo in topologies:
    topo_dir = os.path.join(base_dir, topo)
    if not os.path.exists(topo_dir):
        failed_details.append(f"Missing directory: {topo}")
        continue
    topo_passed = 0
    for wl in expected_workloads:
        total_checked += 1
        fn = f"{wl}_{topo}.json"
        path = os.path.join(topo_dir, fn)
        if not os.path.exists(path):
            failed_details.append(f"Missing file: {topo}/{fn}")
            continue
        try:
            with open(path, "r", encoding="utf-8") as f:
                d = json.load(f)
            completed = d.get("completed", 0)
            failed = d.get("failed", 0)
            out_tok = d.get("output_throughput", 0.0)
            mean_ttft = d.get("mean_ttft_ms", 0.0)
            mean_tpot = d.get("mean_tpot_ms", 0.0)
            mean_itl = d.get("mean_itl_ms", 0.0)
            duration = d.get("duration", 0.0)
            if completed > 0 and failed == 0 and (out_tok > 0 or mean_ttft > 0) and duration > 0:
                total_passed += 1
                topo_passed += 1
            else:
                failed_details.append(f"Invalid data in {topo}/{fn}: completed={completed}, failed={failed}, out_tok={out_tok}, duration={duration}")
        except Exception as e:
            failed_details.append(f"JSON error in {topo}/{fn}: {e}")
    print(f" - {topo:<22} : {topo_passed}/{len(expected_workloads)} workloads verified (completed > 0, failed == 0)")

print(f"\nTotal Workloads Checked: {total_checked}")
print(f"Total Workloads Valid & Passed: {total_passed}/{len(topologies) * len(expected_workloads)}")
if failed_details:
    print("FAILED DETAILS:")
    for err in failed_details[:10]:
        print("  [X]", err)
    sys.exit(1)
else:
    print(f"[PASS] 100% of {len(topologies) * len(expected_workloads)} JSON files exist, are valid JSON, and have zero failed requests.\n")

print("=" * 70)
print(" 2. AUDITING ALL 8 NSIGHT SYSTEMS TRACES (.nsys-rep)")
print("=" * 70)
traces_dir = os.path.join(base_dir, "traces")
expected_traces = [
    "trace1_collocated_1x_tp2_burst.nsys-rep",
    "trace2_disagg_1p1d_burst.nsys-rep",
    "trace3_disagg_1p1d_nvlink_8k.nsys-rep",
    "trace4_disagg_2p2d_infiniband_8k.nsys-rep",
    "trace5_collocated_2x_tp2_allreduce.nsys-rep",
    "trace6_collocated_4x_tp1_noallreduce.nsys-rep",
    "trace7_disagg_2p2d_burst.nsys-rep",
    "trace8_disagg_1p3d_asymmetric.nsys-rep",
]

total_size_mb = 0.0
trace_errors = []
for tf_name in expected_traces:
    tf_path = os.path.join(traces_dir, tf_name)
    if not os.path.exists(tf_path):
        trace_errors.append(f"Missing trace: {tf_name}")
        continue
    sz_bytes = os.path.getsize(tf_path)
    if sz_bytes == 0:
        trace_errors.append(f"Empty trace: {tf_name}")
        continue
    sz_mb = sz_bytes / (1024 * 1024)
    total_size_mb += sz_mb
    print(f" - {tf_name:<45} : {sz_mb:6.2f} MB")

if trace_errors:
    print("\nTRACE ERRORS:")
    for err in trace_errors:
        print("  [X]", err)
    sys.exit(1)

print(f"Total .nsys-rep files verified: {len(expected_traces)}/8")
print(f"Total trace suite size: {total_size_mb:.2f} MB\n")

print("=" * 70)
print(" 3. AUDITING ALL 24 PARSED CSV REPORTS")
print("=" * 70)
reports_dir = os.path.join(traces_dir, "reports")
csv_errors = []
for i in range(1, 9):
    k = os.path.join(reports_dir, f"trace{i}_cuda_gpu_kern_sum.csv")
    a = os.path.join(reports_dir, f"trace{i}_cuda_api_sum.csv")
    n = os.path.join(reports_dir, f"trace{i}_nvtx_sum.csv")
    for report_file, report_type in [(k, "Kernel"), (a, "API"), (n, "NVTX")]:
        if not os.path.exists(report_file) or os.path.getsize(report_file) == 0:
            csv_errors.append(f"Trace {i} {report_type} CSV missing or empty: {os.path.basename(report_file)}")
    k_sz = os.path.getsize(k) if os.path.exists(k) else 0
    a_sz = os.path.getsize(a) if os.path.exists(a) else 0
    n_sz = os.path.getsize(n) if os.path.exists(n) else 0
    print(f" - Trace {i:<2}: Kernel CSV ({k_sz:5d} bytes), API CSV ({a_sz:5d} bytes), NVTX CSV ({n_sz:5d} bytes)")

if csv_errors:
    print("\nCSV REPORT ERRORS:")
    for err in csv_errors:
        print("  [X]", err)
    sys.exit(1)
print(f"Total CSV summary reports verified: 24/24\n")

print("=" * 70)
print(" 4. AUDITING METADATA, SCRIPTS, AND PLANS")
print("=" * 70)
meta_files = [
    os.path.join("docs", "hardware_and_environment_specs.md"),
    os.path.join("patches", "vllm_toy_proxy_server.patch"),
    os.path.join("scripts", "parse_results.py"),
    os.path.join("scripts", "run_benchmarks.sh"),
    os.path.join("scripts", "capture_nsys_traces.sh"),
    os.path.join("scripts", "collocated_round_robin_proxy.py"),
    os.path.join("scripts", "stop_services.sh"),
    # Launch scripts for all 9 topologies
    os.path.join("scripts", "launch_collocated_1x_tp2.sh"),
    os.path.join("scripts", "launch_collocated_2x_tp1.sh"),
    os.path.join("scripts", "launch_collocated_4x_tp1.sh"),
    os.path.join("scripts", "launch_collocated_2x_tp2.sh"),
    os.path.join("scripts", "launch_disagg_1p1d.sh"),
    os.path.join("scripts", "launch_disagg_1p1d_ib.sh"),
    os.path.join("scripts", "launch_disagg_1p2d.sh"),
    os.path.join("scripts", "launch_disagg_1p3d.sh"),
    os.path.join("scripts", "launch_disagg_2p2d.sh"),
]

meta_errors = []
for mf in meta_files:
    full_path = os.path.join(root_dir, mf)
    sz = os.path.getsize(full_path) if os.path.exists(full_path) else -1
    if sz <= 0:
        meta_errors.append(f"Missing or empty file: {mf}")
        status = "MISSING"
    else:
        status = f"PRESENT ({sz} bytes)"
    print(f" - {mf:<45} : {status}")

if meta_errors:
    print("\nMETADATA/SCRIPT ERRORS:")
    for err in meta_errors:
        print("  [X]", err)
    sys.exit(1)

plans_dir = os.path.join(root_dir, "docs", "plans")
if not os.path.exists(plans_dir):
    plans_dir = os.path.join(root_dir, "tmp_archive", "plans")
plan_files = glob.glob(os.path.join(plans_dir, "*.md")) if os.path.exists(plans_dir) else []
print(f"\nApproach & Architecture Plans (archived in {os.path.relpath(plans_dir, root_dir)}): {len(plan_files)} files tracked")

print("\n" + "=" * 70)
print(" VERIFICATION CONCLUSION: COMPLETE & INDISPUTABLE")
print("=" * 70)
